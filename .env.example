ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANALYSIS_MODEL=claude-haiku-4-5-20251001
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
SLACK_USER_ID=U00XXXXXXXX
# Con el token del bot el resumen llega al DM personal; sin el, cae al canal del webhook.
SLACK_BOT_TOKEN=xoxb-your-bot-token
# Carpeta raiz del vault de Obsidian donde vive la nota "Resumen YYYY-MM-DD.md".
OBSIDIAN_VAULT_PATH=
CAPTURE_INTERVAL_MINUTES=5
# window = título de ventana + proceso (gratis, sin API). vision = screenshot + modelo.
CAPTURE_MODE=window
IDLE_THRESHOLD_SECONDS=120
REPORT_HOUR=18
DB_PATH=./data/tracker.db
SCREENSHOTS_DIR=./data/screenshots
